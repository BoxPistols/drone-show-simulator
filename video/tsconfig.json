{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "~/*": ["../src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts/music.ts", "remotion.config.ts"]
}
